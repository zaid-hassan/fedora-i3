/**
 * One Dark rofi theme
 * Based directly on the Nordic theme
 */

* {
    onedark0: #282c34;
    onedark1: #21252b;
    onedark2: #2c323c;
    onedark3: #3e4451;

    onedark4: #abb2bf;
    onedark5: #d7dae0;
    onedark6: #e6e6e6;

    onedark7: #56b6c2;
    onedark8: #88c0d0;
    onedark9: #61afef;
    onedark10: #528bff;
    onedark11: #e06c75;

    onedark12: #d19a66;
    onedark13: #e5c07b;
    onedark14: #98c379;
    onedark15: #c678dd;

    foreground: @onedark9;
    backlight: #ccffeedd;
    background-color: transparent;

    highlight: underline bold #e6e6e6;

    transparent: rgba(40,44,52,0.75);
}

window {
    location: center;
    anchor: center;
    transparency: "screenshot";

    width: 850px;

    padding: 10px;

    border: 1px;
    border-color: @onedark3;
    border-radius: 0px;

    background-color: @transparent;

    spacing: 0;
    children: [ mainbox ];
    orientation: horizontal;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @onedark0;
    padding: 5px;

    border-color: @foreground;
    border: 0px 2px 2px 2px;

    background-color: @onedark7;
}

inputbar {
    color: @onedark6;

    padding: 16px 20px;

    background-color: rgba(33,37,43,0.90);

    border: 1px;
    border-radius: 0px;
    border-color: @onedark10;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 12px 16px;

    border-radius: 0px;

    border-color: @onedark10;
    border: 0px 1px 1px 1px;

    background-color: rgba(40,44,52,0.75);

    dynamic: false;
    lines: 10;
}

element {
    padding: 9px 12px;

    vertical-align: 0.5;

    border-radius: 0px;

    background-color: transparent;

    color: @foreground;
    text-color: @onedark4;
}

element selected.normal {
    background-color: @onedark9;
    text-color: @onedark0;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

button {
    padding: 6px;

    color: @foreground;

    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 0px;

    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}

textbox {
    padding: 8px;

    border-radius: 0px;

    border-color: @onedark10;
    border: 1px;

    background-color: rgba(40,44,52,0.75);

    dynamic: true;

    text-color: @backlight;
}
