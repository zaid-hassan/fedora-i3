; ============================================================
; ONE DARK — Minimal Developer Polybar
; ============================================================

[colors]

; One Dark
background = #282c34
background-alt = #1e2127

foreground = #abb2bf
foreground-alt = #5c6370

blue = #61afef
cyan = #56b6c2
green = #98c379
yellow = #d19a66
red = #e06c75
purple = #c678dd


; ============================================================
; BAR
; ============================================================

[bar/main]

width = 100%
height = 30

bottom = false

background = ${colors.background}
foreground = ${colors.foreground}

border-size = 0
line-size = 2
line-color = ${colors.blue}

padding-left = 1
padding-right = 1

module-margin-left = 1
module-margin-right = 1

font-0 = JetBrainsMono Nerd Font:style=Regular:size=10;2
font-1 = JetBrainsMono Nerd Font:style=Bold:size=10;2

modules-left = i3 title
modules-center =
modules-right = cpu memory network pulseaudio battery date

tray-position = right
tray-padding = 2

cursor-click = pointer
cursor-scroll = ns-resize


; ============================================================
; WORKSPACES
; ============================================================

[module/i3]

type = internal/i3

pin-workspaces = true
index-sort = true

enable-click = true
enable-scroll = false
wrapping-scroll = false

format = <label-state>

; Active
label-focused = %index%
label-focused-foreground = ${colors.background}
label-focused-background = ${colors.blue}
label-focused-padding = 2

; Occupied
label-unfocused = %index%
label-unfocused-foreground = ${colors.foreground}
label-unfocused-background = ${colors.background}
label-unfocused-padding = 2

; Visible on another monitor
label-visible = %index%
label-visible-foreground = ${colors.cyan}
label-visible-padding = 2

; Urgent
label-urgent = %index%
label-urgent-foreground = ${colors.background}
label-urgent-background = ${colors.red}
label-urgent-padding = 2


; ============================================================
; CURRENT WINDOW
; ============================================================

[module/title]

type = internal/xwindow

format = <label>

format-foreground = ${colors.foreground-alt}

label = %title%
label-maxlen = 50

label-empty = "Desktop"
label-empty-foreground = ${colors.foreground-alt}


; ============================================================
; CPU
; ============================================================

[module/cpu]

type = internal/cpu

interval = 2

format = <label>

format-prefix = "CPU "
format-prefix-foreground = ${colors.blue}

label = %percentage:2%%

warn-percentage = 80

format-warn-prefix-foreground = ${colors.yellow}
label-warn-foreground = ${colors.yellow}


; ============================================================
; MEMORY
; ============================================================

[module/memory]

type = internal/memory

interval = 2

format = <label>

format-prefix = "RAM "
format-prefix-foreground = ${colors.cyan}

label = %percentage_used:2%%

warn-percentage = 85

format-warn-prefix-foreground = ${colors.yellow}
label-warn-foreground = ${colors.yellow}


; ============================================================
; NETWORK
; ============================================================

[module/network]

type = internal/network

interface-type = wireless

interval = 3

format-connected = <label-connected>
format-disconnected = <label-disconnected>

label-connected = "NET %local_ip% ↓%downspeed% ↑%upspeed%"
label-connected-foreground = ${colors.green}

label-disconnected = "NET offline"
label-disconnected-foreground = ${colors.red}


; ============================================================
; AUDIO
; ============================================================

[module/pulseaudio]

type = internal/pulseaudio

interval = 2

format-volume = <label-volume>
format-muted = <label-muted>

format-volume-prefix = "VOL "
format-volume-prefix-foreground = ${colors.purple}

label-volume = %percentage%%

label-muted = "VOL muted"
label-muted-foreground = ${colors.red}

click-right = pavucontrol


; ============================================================
; BATTERY
; ============================================================

[module/battery]

type = internal/battery

battery = BAT1
adapter = ACAD

full-at = 98

poll-interval = 5

format-charging = <label-charging>
format-discharging = <label-discharging>
format-full = <label-full>

format-charging-prefix = "BAT "
format-discharging-prefix = "BAT "
format-full-prefix = "BAT "

format-charging-prefix-foreground = ${colors.green}
format-discharging-prefix-foreground = ${colors.blue}
format-full-prefix-foreground = ${colors.green}

label-charging = %percentage%%
label-discharging = %percentage%%
label-full = full

format-low-prefix-foreground = ${colors.red}

low-at = 15


; ============================================================
; DATE / TIME
; ============================================================

[module/date]

type = internal/date

interval = 1

date = %a %d %b
time = %H:%M

label = %date%  %time%

format-prefix = " "
format-prefix-foreground = ${colors.blue}
